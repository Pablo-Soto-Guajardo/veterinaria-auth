{
  "info": {
    "name": "Veterinaria San Marcos - Auth API",
    "description": "Ejecuta primero un login: el script guarda {{token}} y {{refreshToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "tiendaUrl",
      "value": "http://localhost:8082/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login ADMIN (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@duoc.cl\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', datos.token);",
                  "pm.collectionVariables.set('refreshToken', datos.refreshToken);"
                ]
              }
            }
          ]
        },
